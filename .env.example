# Copy this to .env before running `docker compose up`. .env is gitignored
# -- never commit real secrets.

# Required. Write routes on the API refuse to start without this set (see
# src/secondlook/api/auth.py) -- fail closed by design, not an oversight.
# Generate one yourself, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
ATHENA_API_KEY=changeme-generate-a-real-key-before-any-non-local-deployment

# ATHENA_LLM_ENABLED defaults to true even with no key set below -- it
# does NOT auto-disable itself. Without a working key, a synthesis call
# will construct a client, fail at request time, and degrade gracefully
# (llm_used=False), but that's a caught error on every call, not a clean
# skip. To genuinely run in retrieval-only mode -- no LLM call attempted,
# ever -- set this explicitly:
# ATHENA_LLM_ENABLED=false

# Hosted Anthropic API (default provider). Required if ATHENA_LLM_ENABLED
# is true (or unset) and ATHENA_LLM_PROVIDER is "anthropic" (the default).
# ANTHROPIC_API_KEY=
# ATHENA_LLM_MODEL=

# Self-hosted / OpenAI-compatible model instead (vLLM, Ollama,
# text-generation-inference, ...) -- see
# src/secondlook/synthesis/llm_client.py's OpenAICompatibleClient. Set
# ATHENA_LLM_PROVIDER=openai_compatible to use these instead of Anthropic.
# ATHENA_LLM_PROVIDER=openai_compatible
# ATHENA_LLM_BASE_URL=
# ATHENA_LLM_MODEL=
# ATHENA_LLM_API_KEY=

# Postgres credentials. Read by both the postgres service itself and by
# api/migrate to build ATHENA_DATABASE_URL -- change these, not the
# connection string, if you need different credentials.
POSTGRES_DB=athena
POSTGRES_USER=athena
POSTGRES_PASSWORD=athena

# The URL your BROWSER uses to reach the API -- not container-to-container
# traffic, which uses Docker's internal DNS regardless of this value. Only
# change this if you're deploying somewhere other than localhost (a real
# domain, a different port, behind a reverse proxy). This is a build-time
# argument for the web image (see web/Dockerfile) -- changing it requires
# rebuilding the web image, not just restarting the container.
VITE_API_BASE=http://localhost:8000

# Comma-separated list of origins the API will accept browser requests
# from (see api/app.py's CORSMiddleware). Defaults to
# http://localhost:8080 -- the frontend's default published port above --
# so the stack works out of the box. Change this if you serve the
# frontend from a different host/port/domain than the default, or the
# browser will block every request the frontend makes with a CORS error
# even though the API itself is reachable and healthy.
# ATHENA_CORS_ORIGINS=http://localhost:8080
