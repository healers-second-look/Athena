# Railway "api" service variables for the doctor study deployment.
# Generate secrets locally:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit real values. Paste them into Railway's Variables tab.

# Postgres: reference the Railway Postgres plugin; postgres:// is rewritten to psycopg automatically.
ATHENA_DATABASE_URL=${{Postgres.DATABASE_URL}}

# FalkorDB service on Railway's private network.
FALKORDB_HOST=${{falkordb.RAILWAY_PRIVATE_DOMAIN}}
FALKORDB_PORT=6379

# Admin key for invite export / CSV endpoints (header X-Athena-Api-Key).
ATHENA_API_KEY=<generate>

# Study switches.
ATHENA_STUDY_ENABLED=1
ATHENA_STUDY_CASE_SET=/app/src/secondlook/study/case_sets/athena_vs_usual_v1.yaml
STUDY_REQUIRE_ENROLLMENT=1
STUDY_SESSION_SECRET=<generate>
STUDY_CODE_PEPPER=<generate; never change after codes are issued>
STUDY_CASES_PER_ARM=4
# Chat messages per doctor per case. Counted in memory: resets when the API restarts.
STUDY_CHAT_MAX_TURNS=40
# Leave unset until you have checked (runbook, "Client IPs") that the edge overwrites it.
# STUDY_TRUSTED_IP_HEADER=x-real-ip
# Staging only: allows the unreviewed draft set AND lets the Athena chat run without a
# working graph or model (with a warning banner). Must be removed before real doctors.
ATHENA_STUDY_ALLOW_UNREVIEWED=1

# The Athena arm's chatbot. Pick a real model, not the mock default.
ATHENA_STUDY_CHAT_MODEL=anthropic
ANTHROPIC_API_KEY=<your key>

# Exactly your Vercel production URL.
ATHENA_CORS_ORIGINS=https://<your-project>.vercel.app
